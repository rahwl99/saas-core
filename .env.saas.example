# Database
SAAS_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/saas_db

# Firebase Authentication
SAAS_FIREBASE_PROJECT_ID=your-firebase-project-id
SAAS_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
SAAS_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...==\n-----END PRIVATE KEY-----\n"
# Or provide local path:
# SAAS_FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json

# Cashfree Payments
SAAS_BILLING_ENABLED=true
SAAS_CASHFREE_CLIENT_ID=your_cashfree_app_id
SAAS_CASHFREE_CLIENT_SECRET=your_cashfree_secret_key
SAAS_CASHFREE_ENVIRONMENT=SANDBOX
SAAS_CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret
SAAS_CASHFREE_API_VERSION=2023-08-01

# Transactional Emails (Resend)
SAAS_EMAIL_ENABLED=true
SAAS_RESEND_API_KEY=re_123456789
SAAS_RESEND_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile
SAAS_TURNSTILE_ENABLED=false
SAAS_TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Free Trial Configuration
SAAS_TRIAL_ENABLED=true
SAAS_TRIAL_DURATION_DAYS=3
SAAS_TRIAL_CREDITS=10

# Trial Abuse Protection
SAAS_TRIAL_HASH_SECRET=replace-with-a-cryptographically-secure-random-secret-in-production
SAAS_TRIAL_IP_LIMIT_ENABLED=true
SAAS_TRIAL_IP_MAX_TRIALS=2
SAAS_TRIAL_IP_WINDOW_HOURS=24
